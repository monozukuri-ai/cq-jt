from .model import Diagnostic, RawElement, Scene, SourceMetadata
from .container import ContainerInfo, ReadLimits
from .payload import DecodedSegmentInfo
from .mesh import ReadOptions, MeshInfo, MeshInstance, LodChoice, MeshBuffers, MeshScene
from .export import ExportOptions, ExportReport
from .structure import (StructureOptions, StructureScene, GraphNode, Attribute, Material, PropertyAtom,
                        PropertyBinding, PartDefinition, Instance, MissingReference, OpaqueObject)

CORE_VERSION: str
MODEL_API_VERSION: int
INSPECT_API_VERSION: int
PAYLOAD_API_VERSION: int
STRUCTURE_API_VERSION: int
MESH_API_VERSION: int
EXPORT_API_VERSION: int
DEFAULT_MAX_INPUT_BYTES: int
DEFAULT_MAX_SEGMENTS: int
DEFAULT_MAX_SEGMENT_OUTPUT_BYTES: int
DEFAULT_MAX_TOTAL_OUTPUT_BYTES: int
DEFAULT_MAX_LZMA_DICTIONARY_BYTES: int
DEFAULT_MAX_ELEMENTS: int
DEFAULT_MAX_XZ_BLOCKS: int

class NativeScene:
    @staticmethod
    def from_model(model: Scene) -> NativeScene: ...
    def to_model(self) -> Scene: ...
    @property
    def sources(self) -> tuple[SourceMetadata, ...]: ...
    @property
    def raw_elements(self) -> tuple[RawElement, ...]: ...
    @property
    def diagnostics(self) -> tuple[Diagnostic, ...]: ...

def validate_scene(model: Scene) -> None: ...
def inspect_bytes(data: bytes, *, source_id: str = "input", limits: ReadLimits | None = None) -> ContainerInfo: ...
def inspect_file(path: str, *, source_id: str | None = None, limits: ReadLimits | None = None) -> ContainerInfo: ...

class NativeDocument:
    @property
    def container(self) -> ContainerInfo: ...
    @property
    def segments(self) -> tuple[DecodedSegmentInfo, ...]: ...
    @property
    def diagnostics(self) -> tuple[Diagnostic, ...]: ...
    @property
    def total_output_bytes(self) -> int: ...
    @property
    def geometry_decoded(self) -> bool: ...
    def segment_bytes(self, segment_index: int) -> bytes: ...
    def element_bytes(self, segment_index: int, element_index: int) -> bytes: ...
    def raw_element(self, segment_index: int, element_index: int) -> RawElement: ...

def decode_bytes(data: bytes, *, source_id: str = "input", limits: ReadLimits | None = None) -> NativeDocument: ...
def decode_file(path: str, *, source_id: str | None = None, limits: ReadLimits | None = None) -> NativeDocument: ...

class NativeStructure:
    def to_model(self) -> StructureScene: ...
    @property
    def source(self) -> SourceMetadata: ...
    @property
    def sources(self) -> tuple[SourceMetadata, ...]: ...
    @property
    def coordinates_in_meters(self) -> bool: ...
    @property
    def documents(self) -> tuple[NativeDocument, ...]: ...
    @property
    def nodes(self) -> tuple[GraphNode, ...]: ...
    @property
    def attributes(self) -> tuple[Attribute, ...]: ...
    @property
    def materials(self) -> tuple[Material, ...]: ...
    @property
    def atoms(self) -> tuple[PropertyAtom, ...]: ...
    @property
    def bindings(self) -> tuple[PropertyBinding, ...]: ...
    @property
    def parts(self) -> tuple[PartDefinition, ...]: ...
    @property
    def instances(self) -> tuple[Instance, ...]: ...
    @property
    def part_instances(self) -> tuple[Instance, ...]: ...
    @property
    def missing_references(self) -> tuple[MissingReference, ...]: ...
    @property
    def opaque_objects(self) -> tuple[OpaqueObject, ...]: ...
    @property
    def diagnostics(self) -> tuple[Diagnostic, ...]: ...
    @property
    def document(self) -> NativeDocument: ...
    @property
    def complete(self) -> bool: ...
    @property
    def geometry_decoded(self) -> bool: ...

def read_structure_bytes(data: bytes, *, source_id: str = "input", limits: ReadLimits | None = None, options: StructureOptions | None = None) -> NativeStructure: ...
def read_structure_file(path: str, *, source_id: str | None = None, limits: ReadLimits | None = None, options: StructureOptions | None = None) -> NativeStructure: ...

class NativeMeshScene:
    @property
    def structure(self) -> NativeStructure: ...
    @property
    def meshes(self) -> tuple[MeshInfo, ...]: ...
    @property
    def instances(self) -> tuple[MeshInstance, ...]: ...
    @property
    def lod_choices(self) -> tuple[LodChoice, ...]: ...
    @property
    def diagnostics(self) -> tuple[Diagnostic, ...]: ...
    @property
    def complete(self) -> bool: ...
    @property
    def geometry_decoded(self) -> bool: ...
    def to_model(self) -> MeshScene: ...
    def mesh_buffers(self, mesh_id: int) -> MeshBuffers: ...

def read_bytes(data: bytes, *, source_id: str = "input", limits: ReadLimits | None = None, options: ReadOptions | None = None) -> NativeMeshScene: ...
def read_file(path: str, *, source_id: str | None = None, limits: ReadLimits | None = None, options: ReadOptions | None = None) -> NativeMeshScene: ...
def export_glb_bytes(scene: NativeMeshScene, *, options: ExportOptions | None = None) -> tuple[bytes, ExportReport]: ...
def export_glb(scene: NativeMeshScene, path: str, *, options: ExportOptions | None = None, overwrite: bool = False) -> ExportReport: ...
